## Application
APP_NAME=Órbita
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://orbita.local
APP_TIMEZONE=UTC
APP_LOCALE=pt_BR

## Database
DB_CONNECTION=mysql
DB_HOST=orbita_db
DB_PORT=3306
DB_DATABASE=orbita_laravel
DB_USERNAME=orbita
DB_PASSWORD=change-me

## MariaDB container
MARIADB_DATABASE=orbita_laravel
MARIADB_USER=orbita
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me-too

## Valkey
REDIS_PASSWORD=change-me-as-well
REDIS_HOST=orbita_valkey
# REDIS_CLIENT=phpredis
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_CACHE_DB=1
# REDIS_MARKDOWN_DB=2
# REDIS_SESSION_DB=3
# REDIS_QUEUE_DB=4
# REDIS_PERSISTENT=false
# VALKEY_MAXMEMORY=512mb
# VALKEY_MEMORY_LIMIT=768m

## Runtime
SESSION_SECURE_COOKIE=true
# SESSION_LIFETIME=120

## Transactional email
MAIL_MAILER=roundrobin

MAIL_OCI_HOST=smtp.email.sa-saopaulo-1.oci.oraclecloud.com
MAIL_OCI_PORT=587
MAIL_OCI_USERNAME=
MAIL_OCI_PASSWORD=

MAIL_RESEND_HOST=smtp.resend.com
MAIL_RESEND_PORT=587
MAIL_RESEND_USERNAME=resend
MAIL_RESEND_PASSWORD=

# Seconds a provider stays sidelined after a failed send; socket timeout per attempt.
MAIL_ROUNDROBIN_RETRY_AFTER=60
MAIL_SMTP_TIMEOUT=30

MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Single-provider alternative: set MAIL_MAILER=smtp and fill these instead.
# MAIL_SCHEME=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=postmaster@example.com
# MAIL_PASSWORD=

## Logs
#
#   app-AAAA-MM-DD.log     debug/info/notice
#   error-AAAA-MM-DD.log   warning+
#   access-AAAA-MM-DD.log  one JSON line per HTTP request
#
LOG_LEVEL=info
# LOG_CHANNEL=stack
# LOG_STACK=app,error
# LOG_RETENTION_DAYS=14
# LOG_ACCESS_ENABLED=true
# LOG_PATH=/var/www/html/storage/logs

## Error tracking
# SENTRY_LARAVEL_DSN=

## Orbita
# ORBITA_REGISTER=true           # allow new sign-ups
# ORBITA_HTTP_PROXY=             # fallback proxy for outbound calls (oEmbed, scraping, ...)
# TURNSTILE_SITE_KEY=            # Cloudflare Turnstile (public key)
# TURNSTILE_SECRET_KEY=          # Cloudflare Turnstile (secret key)
# ORBITA_THIRD_PARTY_CODE=       # third-party HTML/JS injected into <head>; usually set in the admin
## Edge-cache TTLs (seconds) for anonymous HTML.
# ORBITA_CACHE_BROWSER_MAX_AGE=30
# ORBITA_CACHE_EDGE_MAX_AGE=60
# ORBITA_CACHE_SWR=600
# ORBITA_CACHE_SIE=86400

## Social login (Laravel Socialite)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=            # needs the "Sign In with LinkedIn using OpenID Connect" product
# LINKEDIN_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# INSTAGRAM_CLIENT_ID=           # Instagram Login; Business/Creator account, HTTPS callback only
# INSTAGRAM_CLIENT_SECRET=

# TRUSTED_PROXIES=*
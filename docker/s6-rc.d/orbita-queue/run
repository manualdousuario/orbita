#!/command/with-contenv sh

if [ "${ORBITA_QUEUE:-true}" != "true" ]; then
    echo "[orbita] queue worker disabled by ORBITA_QUEUE"
    # Stay up (idle) instead of exiting: s6-rc would otherwise see the
    # service go down during the startup transaction and fail the bundle.
    exec sleep 2147483647
fi

cd /var/www/html || exit 1

# --sleep=3: polls both queues on every wake; sleep=1 would hammer an idle jobs table. Override with ORBITA_QUEUE_SLEEP.
exec php artisan queue:work \
    --queue=emails,default \
    --sleep="${ORBITA_QUEUE_SLEEP:-3}" \
    --tries=3 \
    --max-time=3600
